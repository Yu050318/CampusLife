location = /_AMapService/v3/assistant/coordinate/convert {
    if ($request_method != GET) { return 405; }
    if ($arg_key != "${AMAP_JS_KEY}") { return 403; }
    if ($arg_jscode != "") { return 400; }
    limit_req zone=nearby_sdk burst=5 nodelay;
    access_log off;
    error_log /dev/null crit;
    proxy_ssl_server_name on;
    proxy_set_header Host restapi.amap.com;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_connect_timeout 2s;
    proxy_read_timeout 5s;
    # convertFrom sends duplicate key/s parameters. Rebuild the required parameters
    # with exactly one configured key; retain SDK platform/s for JS key validation.
    set $args "key=${AMAP_JS_KEY}&jscode=${AMAP_JS_SECURITY_CODE}&platform=$arg_platform&s=$arg_s&locations=$arg_locations&coordsys=$arg_coordsys&callback=$arg_callback";
    proxy_pass https://restapi.amap.com/v3/assistant/coordinate/convert;
}

location /_AMapService/ { return 404; }
