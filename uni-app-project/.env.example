# 复制为 .env.local 后填写，修改后重启 H5 开发服务。
# 高德控制台 → 应用管理 → 添加「Web端(JS API)」类型 Key。
# 配置该 Key 的域名白名单，开发时使用 localhost/127.0.0.1 对应配置。
VITE_AMAP_JS_KEY=

# 同一个 JS API Key 对应的安全密钥（securityJsCode）。
# 只由 Vite 开发代理读取，不能改名为 VITE_ 开头，不能发到浏览器。
AMAP_JS_SECURITY_CODE=

# 新模块独立接口地址，保持 /api 即走同源代理；不影响原有 BASE_URL。
VITE_NEARBY_API_BASE=/api

# 仅供本地开发代理使用，后端实际运行地址。
NEARBY_BACKEND_URL=http://127.0.0.1:8081

# 可选：人工核验过的校园中心 GCJ-02 坐标，顺序「经度,纬度」。
# 留空则显示中国范围视图，定位失败时可拖动地图选点。
VITE_NEARBY_CAMPUS_CENTER=
