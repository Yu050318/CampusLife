# 后端配置示例：复制为 .env.local 后填写。禁止提交 .env.local。
# Spring Boot 不会自动读取 .env 文件；加载方式见 docs/nearby-places.md。

# 高德控制台 → 应用管理 → 创建「Web服务」类型 Key（不是 JS API Key）。
AMAP_WEB_KEY=

# 每个来源 IP 每 60 秒最多查询次数。
NEARBY_RATE_LIMIT=30

# 只填写部署时受信任反向代理的实际 IP，逗号分隔。
# 本地经 Vite 代理时通常为 127.0.0.1,::1；生产按实际网络填写。
# 受信任代理必须覆盖 X-Real-IP，禁止原样转发用户提供的该请求头。
NEARBY_TRUSTED_PROXIES=127.0.0.1,::1
